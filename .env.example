# Shared local PostgreSQL connection used by the backend.
VAULTNOTE_DATABASE_URL=jdbc:postgresql://localhost:5432/vault_note
VAULTNOTE_DATABASE_USERNAME=user
VAULTNOTE_DATABASE_PASSWORD=password

# Mailpit SMTP and web UI ports.
VAULTNOTE_MAILPIT_SMTP_PORT=1025
VAULTNOTE_MAILPIT_UI_PORT=8025

# SMTP settings consumed by the local Spring Boot profile.
VAULTNOTE_MAIL_HOST=localhost
VAULTNOTE_MAIL_PORT=1025
VAULTNOTE_MAIL_USERNAME=
VAULTNOTE_MAIL_PASSWORD=
VAULTNOTE_MAIL_SMTP_AUTH=false
VAULTNOTE_MAIL_SMTP_STARTTLS=false
VAULTNOTE_MAIL_FROM=no-reply@vaultnote.local

# Email verification settings.
VAULTNOTE_EMAIL_VERIFICATION_BASE_URL=http://localhost:4200
VAULTNOTE_EMAIL_VERIFICATION_TOKEN_TTL=PT24H
