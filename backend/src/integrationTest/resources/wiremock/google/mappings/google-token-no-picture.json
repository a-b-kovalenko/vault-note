{
  "request": {
    "method": "POST",
    "urlPath": "/oauth2/token",
    "bodyPatterns": [
      {
        "contains": "code=mock-no-picture-code"
      },
      {
        "contains": "code_verifier="
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "google-token-response-no-picture.json"
  }
}
