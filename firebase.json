{
  "hosting": {
    "site": "vaultnote-505715",
    "public": "frontend/dist/frontend/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "vault-note",
          "region": "europe-north2"
        }
      },
      {
        "source": "/csrf",
        "run": {
          "serviceId": "vault-note",
          "region": "europe-north2"
        }
      },
      {
        "source": "/oauth2/**",
        "run": {
          "serviceId": "vault-note",
          "region": "europe-north2"
        }
      },
      {
        "source": "/login/oauth2/**",
        "run": {
          "serviceId": "vault-note",
          "region": "europe-north2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
